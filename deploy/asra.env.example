# /etc/asra/asra.env, read by asra.service. install.sh fills in the database
# login from the file deploy/postgres/setup.sh makes.
# Login for the website (asra_app): it can add signatures and count them, nothing more.
ASRA_DATABASE_URL=
ASRA_HOST=127.0.0.1
ASRA_PORT=8080
# Signatures accepted per connection per hour. Kept generous for street stalls
# where many people sign from one phone or wifi network.
ASRA_RATE_LIMIT=30
# Header a CDN in front sets to the visitor's address. Cloudflare: CF-Connecting-IP.
ASRA_CLIENT_IP_HEADER=
# 1 when Caddy sits behind another reverse proxy (install.sh sets this when
# TRUSTED_PROXY is given), so limits apply to visitors rather than the proxy.
ASRA_PROXY_HOPS=0
