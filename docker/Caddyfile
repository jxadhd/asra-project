# SITE_ADDRESS and TRUSTED_PROXY come from /etc/asra/compose.env (see compose.yaml).
{
	servers {
		trusted_proxies static {$TRUSTED_PROXY:127.0.0.1/32}
	}
}

{$SITE_ADDRESS::80} {
	root * /srv
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# No access log: the site does not record visitors' IP addresses.

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		header Cache-Control "public, max-age=300"
		file_server
	}
}
